# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Servidor SMTP para enviar los pedidos de cotización
# (ej. Gmail: smtp.gmail.com / 465 / SSL, con una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion

# Opcional: forzar otro modelo
# CLAUDE_MODEL=claude-opus-5-5

# Planilla de proveedores en Google Sheets (ver README, sección "Planilla en Drive")
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS=credenciales-google.json

# Lectura de respuestas: por defecto usa el mismo usuario/contraseña que SMTP
# IMAP_HOST=imap.gmail.com
